{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapters": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "enum": [
          "codex",
          "claude",
          "grok",
          "generic"
        ]
      },
      "title": "Adapters",
      "type": "object"
    },
    "agents": {
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Agents",
      "type": "array"
    },
    "config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "managed_files": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minProperties": 1,
      "title": "Managed Files",
      "type": "object"
    },
    "profile": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Profile",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "maximum": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "skills": {
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Skills",
      "type": "array"
    },
    "source_commit": {
      "anyOf": [
        {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Commit"
    },
    "stacks": {
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Stacks",
      "type": "array"
    },
    "toolkit_version": {
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
      "title": "Toolkit Version",
      "type": "string"
    },
    "workflows": {
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Workflows",
      "type": "array"
    }
  },
  "required": [
    "toolkit_version",
    "source_commit",
    "config_sha256",
    "profile",
    "stacks",
    "skills",
    "agents",
    "workflows",
    "adapters",
    "managed_files"
  ],
  "title": "ToolkitLock",
  "type": "object"
}
